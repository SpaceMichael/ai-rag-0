# ============================================================
# ai-rag-0 環境變數設定
# 複製此檔案為 .env 並填入實際值
# ============================================================

# --- AI 供應商選擇（只需填一個） ---
# 可選值: ollama | openai | gemini | anthropic
AI_PROVIDER=ollama

# --- Ollama（本地 AI，免費，私隱保護）---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- OpenAI（如需切換）---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Google Gemini（如需切換）---
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_LLM_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=models/embedding-001

# --- Anthropic Claude（如需切換）---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_LLM_MODEL=claude-3-haiku-20240307

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/ai_rag_db

# --- RAG 參數 ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
EMBED_DIMENSIONS=768        # nomic-embed-text=768, OpenAI small=1536, Gemini=768

# --- 防幻覺設定 ---
MIN_CONFIDENCE_SCORE=0.70   # 低於此值拒絕回答
HALLUCINATION_THRESHOLD=0.80
MAX_RETRY_ATTEMPTS=3

# --- 應用設定 ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
